# ================================================================
# .env.example
# ----------------------------------------------------------------
# PURPOSE : TEMPLATE of the settings for running the nightly job on your PC.
#           Copy (do not rename) this file to ".env" in the same folder and
#           fill in the values. Meaning of each line: job/config.js.
#           On GitHub the same names are repository Secrets / Variables.
#
# RUN     : npm run job
#
# CHANGE LOG
# - 2026-10-14 : Initial version.
#     * DRY_RUN=true and GLOBAL_TEST_MODE=true by default: a first local run
#       only reads and prints. Set DRY_RUN=false to really send (still only
#       to TEST_RECIPIENT while GLOBAL_TEST_MODE=true).
#     * NEVER commit ".env" - it holds the secret (.gitignore blocks it).
# - 2026-10-14 : Re-created with PLACEHOLDERS instead of real values.
#     * WHY: this file goes to the PUBLIC GitHub repo; staff email addresses
#       and company IDs stay in .env / GitHub settings only.
# ================================================================

TENANT_ID=<Directory (tenant) ID from Entra>
CLIENT_ID=<Application (client) ID of "Mirage Tracker Reminder - Job">
CLIENT_SECRET=<secret VALUE - never commit>
SENDER_MAILBOX=<shared mailbox, e.g. project-reminders@yourcompany.com>
CONFIG_SITE_HOST=<tenant>.sharepoint.com
CONFIG_SITE_PATH=/sites/Automation
CONFIG_FOLDER=Application_Files/TrackerReminder
ALERT_EMAIL=<who gets "the job failed" emails>
TEST_RECIPIENT=<who gets ALL emails while test mode is on>
GLOBAL_TEST_MODE=true
DRY_RUN=true
